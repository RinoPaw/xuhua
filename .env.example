HOST=127.0.0.1
PORT=5050
DEBUG=0
DATASET_PATH=data/processed/heritage_items.json

AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
AI_TIMEOUT=60
AI_FIRST_TOKEN_TIMEOUT=8
AI_FIRST_TOKEN_MAX_ATTEMPTS=2
AI_RESPONSE_TIMEOUT=75
AI_MAX_OUTPUT_CHARS=6000
AI_MAX_CONTEXT_CHARS=5200

XF_APP_ID=
XF_API_KEY=
XF_API_SECRET=
XF_ASR_HOST=iat.xf-yun.com

# Official iFLYTEK streaming TTS (requires its own service entitlement).
# Empty credential overrides reuse XF_APP_ID / XF_API_KEY / XF_API_SECRET.
XF_TTS_APP_ID=
XF_TTS_API_KEY=
XF_TTS_API_SECRET=
# Voice IDs depend on the voices enabled in your iFLYTEK TTS console.
# 讯飞小露：普通话女声；需要在对应讯飞应用中开通此音色。
XF_TTS_VOICE_ZH=x4_yezi
XF_TTS_VOICE_EN=xiaoyan
XF_TTS_VOICE_YUE=
XF_TTS_VOICE_JA=
XF_TTS_VOICE_KO=

CHAT_MAX_CONCURRENCY=8
CHAT_MAX_PER_MINUTE=60
CHAT_MAX_PER_CLIENT_PER_MINUTE=20
TTS_MAX_CONCURRENCY=12
TTS_MAX_PER_MINUTE=240
TTS_MAX_PER_CLIENT_PER_MINUTE=80
VOICE_MAX_CONCURRENCY=4
VOICE_MAX_PER_MINUTE=30
VOICE_MAX_PER_CLIENT_PER_MINUTE=8
