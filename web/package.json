{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prepare:assets": "node scripts/prepare-wake-assets.mjs",
    "check:assets": "node scripts/prepare-wake-assets.mjs --check",
    "build": "npm run check:assets && vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "lint": "npx --yes @biomejs/biome@2.5.14 lint src --only=correctness/useExhaustiveDependencies --only=correctness/useHookAtTopLevel --only=correctness/noUnusedImports --only=correctness/noUnusedVariables",
    "test": "node --test tests/*.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "vite": "6.4.2"
  }
}
