[Unit]
Description=Shizha anti-fraud assistant
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xuhua
Group=xuhua
WorkingDirectory=/opt/xuhua
EnvironmentFile=/etc/shizha.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/xuhua/.venv/bin/uvicorn --app-dir /opt/xuhua/deploy shizha_asgi:app --host 127.0.0.1 --port 5051 --workers 1 --ws-max-size 65536 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
